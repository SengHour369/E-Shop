# Keep disabled until this specific Gemini Developer API project is confirmed UNBILLED.
# Never put these variables in Angular environment files or browser assets.
GEMINI_API_KEY=
GEMINI_LIVE_ENABLED=false
GEMINI_FREE_PROJECT_VERIFIED=false
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
AI_VOICE_MAX_CALLS_PER_DAY=5
AI_VOICE_MAX_DURATION_SECONDS=300
# Existing Redis connection, shared by every ai-service instance/device.
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional authenticated, editable voice-message transcription (separate from Live calls).
GEMINI_TRANSCRIPTION_ENABLED=false
GEMINI_TRANSCRIPTION_MODEL=gemini-3.1-flash-lite
